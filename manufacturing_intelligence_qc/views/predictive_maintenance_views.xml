<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_miqc_predictive_maintenance_tree" model="ir.ui.view">
        <field name="name">miqc.predictive.maintenance.tree</field>
        <field name="model">miqc.predictive.maintenance</field>
        <field name="arch" type="xml">
            <tree string="Predictive Maintenance" decoration-danger="risk_level == 'critical'" decoration-warning="risk_level == 'high'">
                <field name="name"/>
                <field name="machine_id"/>
                <field name="asset_name"/>
                <field name="risk_level"/>
                <field name="predicted_failure_date"/>
                <field name="ai_confidence"/>
                <field name="maintenance_type"/>
                <field name="state"/>
                <field name="assigned_to"/>
            </tree>
        </field>
    </record>

    <record id="view_miqc_predictive_maintenance_form" model="ir.ui.view">
        <field name="name">miqc.predictive.maintenance.form</field>
        <field name="model">miqc.predictive.maintenance</field>
        <field name="arch" type="xml">
            <form string="Predictive Maintenance">
                <header>
                    <button name="action_start" type="object" string="Start" class="oe_highlight" invisible="state != 'scheduled'"/>
                    <button name="action_done" type="object" string="Done" class="oe_highlight" invisible="state != 'in_progress'"/>
                    <button name="action_schedule" type="object" string="Re-schedule" invisible="state == 'scheduled'"/>
                    <field name="state" widget="statusbar" statusbar_visible="scheduled,in_progress,done"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="machine_id"/>
                            <field name="asset_name"/>
                        </group>
                        <group>
                            <field name="risk_level"/>
                            <field name="maintenance_type"/>
                            <field name="predicted_failure_date"/>
                        </group>
                    </group>
                    <group string="AI Prediction">
                        <field name="ai_confidence"/>
                    </group>
                    <group>
                        <group>
                            <field name="assigned_to"/>
                        </group>
                    </group>
                    <group string="Notes">
                        <field name="notes" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_miqc_predictive_maintenance" model="ir.actions.act_window">
        <field name="name">Predictive Maintenance</field>
        <field name="res_model">miqc.predictive.maintenance</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new predictive maintenance alert
            </p>
        </field>
    </record>
</odoo>
