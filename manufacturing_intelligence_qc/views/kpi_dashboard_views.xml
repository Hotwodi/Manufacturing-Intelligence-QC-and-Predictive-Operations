<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_miqc_kpi_dashboard_tree" model="ir.ui.view">
        <field name="name">miqc.kpi.dashboard.tree</field>
        <field name="model">miqc.kpi.dashboard</field>
        <field name="arch" type="xml">
            <tree string="KPI Dashboard">
                <field name="name"/>
                <field name="period"/>
                <field name="oee"/>
                <field name="availability"/>
                <field name="performance"/>
                <field name="quality_rate"/>
                <field name="scrap_rate"/>
                <field name="on_time_delivery"/>
            </tree>
        </field>
    </record>

    <record id="view_miqc_kpi_dashboard_form" model="ir.ui.view">
        <field name="name">miqc.kpi.dashboard.form</field>
        <field name="model">miqc.kpi.dashboard</field>
        <field name="arch" type="xml">
            <form string="KPI Dashboard">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="period"/>
                        </group>
                    </group>
                    <group string="KPI Metrics">
                        <group>
                            <field name="oee"/>
                            <field name="availability"/>
                            <field name="performance"/>
                        </group>
                        <group>
                            <field name="quality_rate"/>
                            <field name="scrap_rate"/>
                            <field name="on_time_delivery"/>
                        </group>
                    </group>
                    <group string="AI Trend Prediction">
                        <field name="ai_trend_prediction" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_miqc_kpi_dashboard" model="ir.actions.act_window">
        <field name="name">KPI Dashboard</field>
        <field name="res_model">miqc.kpi.dashboard</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new KPI dashboard entry
            </p>
        </field>
    </record>
</odoo>
